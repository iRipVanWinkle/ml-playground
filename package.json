{
    "name": "ml-playground",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "npm run copy-wasm && vite",
        "build": "npm run copy-wasm && tsc -b && vite build",
        "build:gh-pages": "NODE_ENV=production npm run build",
        "copy-wasm": "mkdir -p public/wasm && cp node_modules/@tensorflow/tfjs-backend-wasm/dist/*.wasm public/wasm/",
        "lint": "eslint . --ext .ts,.tsx",
        "lint:fix": "eslint . --ext .ts,.tsx --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run test:e2e",
        "preview": "vite preview"
    },
    "dependencies": {
        "@radix-ui/react-checkbox": "^1.3.2",
        "@radix-ui/react-collapsible": "^1.1.12",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-hover-card": "^1.1.14",
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-progress": "^1.1.7",
        "@radix-ui/react-radio-group": "^1.3.7",
        "@radix-ui/react-select": "^2.2.5",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slider": "^1.3.5",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.5",
        "@radix-ui/react-tabs": "^1.1.12",
        "@radix-ui/react-tooltip": "^1.2.7",
        "@tailwindcss/vite": "^4.1.10",
        "@tensorflow/tfjs": "^4.22.0",
        "@tensorflow/tfjs-backend-wasm": "^4.22.0",
        "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "eslint-plugin-react-compiler": "^19.1.0-rc.2",
        "lucide-react": "^0.555.0",
        "next-themes": "^0.4.6",
        "plotly.js": "^3.3.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-plotly.js": "^2.6.0",
        "sonner": "^2.0.6",
        "tailwind-merge": "^3.3.1",
        "tailwindcss": "^4.1.10",
        "zustand": "^5.0.6"
    },
    "devDependencies": {
        "@eslint/js": "^9.25.0",
        "@playwright/test": "^1.55.0",
        "@types/node": "^24.0.3",
        "@types/plotly.js": "^3.0.0",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "@types/react-plotly.js": "^2.6.3",
        "@typescript-eslint/eslint-plugin": "^8.30.1",
        "@typescript-eslint/parser": "^8.30.1",
        "@vitejs/plugin-react": "^5.1.0",
        "@vitest/coverage-v8": "^4.0.5",
        "babel-plugin-react-compiler": "^19.1.0-rc.3",
        "baseline-browser-mapping": "^2.9.11",
        "eslint": "^9.25.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.35.0",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^16.0.0",
        "jsdom": "^27.0.1",
        "prettier": "^3.3.3",
        "ts-node": "^10.9.2",
        "tw-animate-css": "^1.3.4",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.30.1",
        "vite": "^7.2.6",
        "vitest": "^4.0.5"
    }
}
